# Moolias application
# --------------------

# Public HTTPS URL used for OAuth callbacks and application URLs.
# Do not add a trailing slash.
MOOLIAS_BASE_URL=https://aliases.example.com

# Secret used to sign Moolias sessions. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
MOOLIAS_SESSION_SECRET=replace-with-a-long-random-secret

# Keep enabled for normal HTTPS deployments.
# Set to false only for local HTTP development where secure cookies cannot be used.
MOOLIAS_COOKIE_SECURE=true

# Comma-separated Host header values accepted by Moolias.
# Usually this is the hostname from MOOLIAS_BASE_URL.
# "*" allows every host and is not recommended for an Internet-facing deployment.
MOOLIAS_TRUSTED_HOSTS=aliases.example.com

# Optional mailcow tag used to restrict who may log in to Moolias.
# Empty = every authenticated mailcow mailbox is allowed.
# When set, the tag may be assigned either to an individual mailbox or to its domain
# in the mailcow administration UI. Matching is case-insensitive.
# The recommended Mailcow-host installer offers moolias-access by default.
# Example: MOOLIAS_ACCESS_TAG=moolias-access
MOOLIAS_ACCESS_TAG=


# Optional primary sender protection
# ----------------------------------

# Disabled by default. Moolias remains fully functional without the Mailcow Agent.
# When enabled, the dashboard checks the agent before exposing the mailbox sender
# protection switch. See docs/sender-protection.md for the one-command bootstrap.
MOOLIAS_SENDER_PROTECTION=false

# Shared HMAC secret used by the Moolias Mailcow Agent.
# The recommended Mailcow-host installer creates and stores this automatically.
MOOLIAS_SENDER_AGENT_SECRET=

# Optional custom agent URL. The recommended Mailcow-host installer points this to
# Mailcow nginx over the private Docker network. Standalone deployments may leave it
# empty to use <MAILCOW_URL>/moolias-agent.
MOOLIAS_SENDER_AGENT_URL=

# Minimum delay between actual sender-protection changes for one mailbox.
# The agent independently enforces its own cooldown as well.
MOOLIAS_SENDER_PROTECTION_COOLDOWN_SECONDS=10


# Optional usage statistics
# -------------------------

# Disabled by default. When false, Moolias does not create/open a statistics database,
# does not start the collector and does not request Rspamd history for statistics.
MOOLIAS_USAGE_STATS=false

# Base mailcow tag for the statistics policy. Required when statistics are enabled.
# With the default value the modes are:
#   moolias-stats-off    = no new statistics
#   moolias-stats        = received/sent counters
#   moolias-stats-domain = counters + sender domains
#   moolias-stats-full   = counters + full sender addresses
# A mailbox tag overrides the domain tag. With no mailbox mode tag, the domain mode
# is inherited. Moolias users may change only this statistics-tag family for their
# own mailbox; unrelated tags such as MOOLIAS_ACCESS_TAG are preserved.
MOOLIAS_USAGE_TAG=moolias-stats

# Persistent SQLite database used only when usage statistics are enabled.
MOOLIAS_USAGE_DB_PATH=/data/moolias-stats.sqlite3

# Collector interval and maximum Rspamd history window. Moolias normally loads a much
# smaller adaptive window (10 -> 25 -> 50 -> 100 -> 250 -> 500) and only reaches this
# maximum when the previous watermark cannot be covered with at least 10% headroom.
MOOLIAS_USAGE_POLL_SECONDS=60
MOOLIAS_USAGE_HISTORY_COUNT=1000

# Mark the collector as stale when this many expected poll intervals pass without a
# successful collection. The default 3 means 180 seconds with a 60-second poll interval.
# A failed latest attempt is reported as failed immediately, independently of this value.
# See docs/statistics-collector-health.md for the coverage/headroom definition.
MOOLIAS_USAGE_STALE_POLLS=3


# mailcow connection
# ------------------

# Public URL of the mailcow instance. Browser-facing OAuth authorization always uses
# this URL. Do not add a trailing slash.
MAILCOW_URL=https://mail.example.com

# Optional private URL used only for server-side Mailcow API/OAuth calls.
# Leave empty for normal standalone deployments. The recommended same-host installer
# fills this automatically from Mailcow's HTTP_PORT, for example:
#   http://nginx-mailcow:80
# or, when Mailcow uses HTTP_PORT=8080:
#   http://nginx-mailcow:8080
MAILCOW_INTERNAL_URL=

# mailcow read/write API key used to create and manage aliases and to update the
# authenticated mailbox's statistics tags when statistics self-service is enabled.
# Restrict the key to the Moolias source network in mailcow where possible. For the
# recommended same-host installation, the installer prints the exact Docker CIDR.
MAILCOW_API_KEY=replace-with-mailcow-read-write-api-key

# OAuth2 client configured in mailcow.
# Redirect URI: <MOOLIAS_BASE_URL>/oauth/callback
MAILCOW_OAUTH_CLIENT_ID=replace-with-oauth-client-id
MAILCOW_OAUTH_CLIENT_SECRET=replace-with-oauth-client-secret

# Verify the TLS certificate presented by mailcow when HTTPS is used.
# The recommended same-host backend URL uses private HTTP inside Mailcow's Docker network.
# Disable only when intentionally using an internal/self-signed HTTPS certificate.
MAILCOW_VERIFY_TLS=true


# Docker Compose deployment
# -------------------------

# Host port published by the repository's compose.yml.
# Ignored by deployments such as a private reverse-proxy network that do not publish a port.
MOOLIAS_PORT=8080

# Container image channel or fixed image tag used by Docker Compose.
# latest = latest stable release
# edge   = current unreleased main branch
# A fixed SemVer tag such as 0.1.3 can also be used for a pinned deployment.
# update.sh overrides this value for its own stable/beta invocation without editing .env.
MOOLIAS_TAG=latest


# Updater-only shell option
# -------------------------

# MOOLIAS_COMPOSE_FILE is supported by update.sh when a deployment uses a custom
# Compose filename. It is a shell environment variable and is intentionally not
# defined as a normal .env setting because update.sh does not source this file.
# Example:
#   MOOLIAS_COMPOSE_FILE=compose.production.yml ./update.sh
